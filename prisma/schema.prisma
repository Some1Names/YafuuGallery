generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  reader
  author
  admin
}

enum Language {
  th
  en
  ja
}

// A whole manga's publication state (the Ongoing/Completed filter on the
// search page) — separate from ArcStatus, which is per arc.
enum MangaStatus {
  ongoing
  completed
}

enum ArcStatus {
  ongoing
  completed
}

// ---------- User ----------
// name/image/emailVerified are named to match Better Auth's Prisma adapter
// expectations exactly — renaming these breaks the adapter silently.
// created_at/updated_at are mapped to Better Auth's expected createdAt/
// updatedAt field names via the `user.fields` config in lib/auth.ts, so the
// rest of the app can keep reading/ordering by created_at unchanged.

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  // 4-digit discriminator (Riot ID / old-Discord style) — "name" alone is
  // NOT unique (two people can both be "uefa123"), but "name#tag" always
  // is. Assigned once at signup (lib/auth.ts's user.create.before hook)
  // and never changes; nullable only because a value has to exist before
  // the @@unique below can ever be satisfied on insert.
  tag           String?
  image         String?
  role          Role     @default(reader)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  // Better Auth adapter relations
  accounts Account[]
  sessions Session[]

  // app relations
  manga             Manga[]           @relation("AuthoredManga")
  translations      Translation[]     @relation("TranslatedBy")
  comments          Comment[]
  comment_likes     CommentLike[]
  comment_reports   CommentReport[]   @relation("CommentReports")
  bookmarks         Bookmark[]
  chapter_bookmarks ChapterBookmark[]
  reading_progress  ReadingProgress[]

  @@unique([name, tag])
}

// ---------- Better Auth adapter tables ----------
// Required as-is by better-auth's Prisma adapter — field names and shape
// are fixed. Password (for email/password accounts) lives on Account.password,
// not on User — there's one Account row per sign-in method per user.

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  // synthetic issuer better-auth derives per provider (e.g. "local:credential"
  // for email/password, an OAuth-namespaced value for social providers) —
  // this, not providerId, is what it treats as the account's natural key
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Manga ----------

model Manga {
  id               String   @id @default(cuid())
  author_id        String
  manga_title      String
  manga_synopsis   String
  cover_image_url  String? // poster-style cover, used in browse grids / cards
  banner_image_url String? // wide hero image, used on the detail page
  // Admin-curated home page carousel — is_featured is a plain toggle, and
  // featured_order is set to (current max + 1) whenever it's turned on, so
  // the carousel order is simply "the order manga were featured in" with
  // no separate manual-reorder UI. Meaningless while is_featured is false.
  is_featured      Boolean  @default(false)
  featured_order   Int      @default(0)
  // Genre slugs from lib/genres.ts (the route handlers drop anything not
  // on that list), picked by the author. Filtered with `has` on /search.
  genres           String[] @default([])
  manga_status     MangaStatus @default(ongoing)
  // Sum of this manga's chapters' view_count, kept alongside it so /search
  // can sort by "Most viewed" in the database (Prisma can't order by a
  // relation's SUM). Incremented with raw SQL in the viewer — a Prisma
  // update would also bump updated_at and make every read look like an
  // "update".
  view_count       Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  author    User       @relation("AuthoredManga", fields: [author_id], references: [id])
  arcs      Arc[]
  chapters  Chapter[]
  bookmarks Bookmark[]

  @@index([author_id])
  // Home page hero query filters on is_featured then sorts by
  // featured_order — a composite index serves both parts of that query in
  // one pass instead of a full-table scan.
  @@index([is_featured, featured_order])
  // Home page and search both list every manga ordered by updated_at.
  @@index([updated_at])
}

// ---------- Arc ----------

model Arc {
  id            String    @id @default(cuid())
  manga_id      String
  arc_name      String
  arc_order     Int
  // Any number of arcs on a manga can be flagged as special "ex"
  // (bonus/omake) entries — independent of arc_order, so each can be
  // dragged to sit anywhere in the list while always displaying "ex"
  // instead of a position number.
  arc_is_ex     Boolean   @default(false)
  arc_status    ArcStatus @default(ongoing)
  arc_image_url String? // cover image shown when browsing by arc
  created_at    DateTime  @default(now())

  manga    Manga     @relation(fields: [manga_id], references: [id], onDelete: Cascade)
  chapters Chapter[]

  // total_chapters and total_view are intentionally NOT stored here —
  // compute them at query time:
  //   total_chapters = chapters.length
  //   total_view     = sum(chapters[].view_count)

  @@unique([manga_id, arc_order])
  @@index([manga_id])
}

// ---------- Chapter ----------

model Chapter {
  id              String   @id @default(cuid())
  manga_id        String
  arc_id          String?
  chapter_number  Int
  // Any number of chapters on a manga can be flagged as special "ex"
  // (bonus/omake) entries — independent of chapter_number, so each can be
  // dragged to sit anywhere in the list while always displaying "ex"
  // instead of a position number. Mirrors Arc.arc_is_ex.
  chapter_is_ex   Boolean  @default(false)
  chapter_name    String
  cover_image_url String? // thumbnail shown in the chapter list
  published_date  DateTime
  view_count      Int      @default(0)
  comment_count   Int      @default(0)
  created_at      DateTime @default(now())

  manga             Manga             @relation(fields: [manga_id], references: [id], onDelete: Cascade)
  arc               Arc?              @relation(fields: [arc_id], references: [id], onDelete: SetNull)
  translations      Translation[]
  comments          Comment[]
  reading_progress  ReadingProgress[]
  chapter_bookmarks ChapterBookmark[]

  @@unique([manga_id, chapter_number])
  @@index([manga_id])
  @@index([arc_id])
}

// ---------- Translation ----------

model Translation {
  id            String   @id @default(cuid())
  chapter_id    String
  language      Language
  file_url      String
  // Original filename as uploaded (e.g. "chapter-12-final.pdf") — the R2
  // object key itself is a random UUID, so this is purely for display in
  // the admin panel. Nullable since translations created before this field
  // existed have none.
  file_name     String?
  translator_id String?
  created_at    DateTime @default(now())

  chapter    Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  translator User?   @relation("TranslatedBy", fields: [translator_id], references: [id])

  @@unique([chapter_id, language])
  @@index([chapter_id])
}

// ---------- Comment ----------

model Comment {
  id         String    @id @default(cuid())
  user_id    String
  chapter_id String
  body       String
  hidden_at  DateTime?
  created_at DateTime  @default(now())
  // Set on replies: the top-level comment of the thread. Threads are one
  // level deep — replying to a reply attaches to the same top-level
  // comment (the API normalises it). Deleting a comment deletes its replies.
  parent_id  String?

  user    User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter Chapter         @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  parent  Comment?        @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies Comment[]       @relation("CommentReplies")
  likes   CommentLike[]
  reports CommentReport[]

  @@index([chapter_id])
  @@index([user_id])
  // the comment rate limit counts a user's recent comments
  @@index([user_id, created_at])
  @@index([parent_id])
}

// A reader flagging someone else's comment for moderation — surfaces it in
// the admin and author Comments tabs. One report per reader per comment;
// cleared when a moderator dismisses them (or the comment is deleted).
model CommentReport {
  id          String   @id @default(cuid())
  comment_id  String
  reporter_id String
  created_at  DateTime @default(now())

  comment  Comment @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  reporter User    @relation("CommentReports", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@unique([comment_id, reporter_id])
  @@index([comment_id])
}

// ---------- Comment Like ----------
// like_count is intentionally NOT stored on Comment — same reasoning as
// Arc's total_chapters/total_view: compute it at query time via _count
// instead of keeping a counter in sync on every like/unlike.

model CommentLike {
  id         String   @id @default(cuid())
  user_id    String
  comment_id String
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@unique([user_id, comment_id])
  @@index([comment_id])
}

// ---------- Bookmark ----------

model Bookmark {
  id         String   @id @default(cuid())
  user_id    String
  manga_id   String
  created_at DateTime @default(now())
  // Chapters uploaded after this and not opened yet count as "new" for
  // this reader (lib/favorite-updates.ts). Starts at favoriting time, so
  // favoriting a finished series doesn't flood Updates with its back
  // catalogue; "Mark all as read" moves it to now.
  updates_seen_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [manga_id], references: [id], onDelete: Cascade)

  @@unique([user_id, manga_id])
  @@index([manga_id])
}

// ---------- Chapter Bookmark ----------
// Separate from Bookmark (which is manga-level) — this is "favorite this
// specific chapter", a different relationship with its own unique pair.

model ChapterBookmark {
  id         String   @id @default(cuid())
  user_id    String
  chapter_id String
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@unique([user_id, chapter_id])
  @@index([chapter_id])
}

model ReadingProgress {
  id             String   @id @default(cuid())
  user_id        String
  chapter_id     String
  last_page_read Int      @default(0)
  completed      Boolean  @default(false)
  updated_at     DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@unique([user_id, chapter_id])
  @@index([chapter_id])
}
