generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  reader
  author
  admin
}

enum Language {
  th
  en
  ja
}

enum ArcStatus {
  ongoing
  completed
}

// ---------- User ----------
// name/image/emailVerified are named to match Better Auth's Prisma adapter
// expectations exactly — renaming these breaks the adapter silently.
// created_at/updated_at are mapped to Better Auth's expected createdAt/
// updatedAt field names via the `user.fields` config in lib/auth.ts, so the
// rest of the app can keep reading/ordering by created_at unchanged.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  role          Role      @default(reader)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  // Better Auth adapter relations
  accounts Account[]
  sessions Session[]

  // app relations
  manga            Manga[]        @relation("AuthoredManga")
  translations      Translation[] @relation("TranslatedBy")
  comments          Comment[]
  bookmarks         Bookmark[]
  chapter_bookmarks ChapterBookmark[]
  reading_progress  ReadingProgress[]
}

// ---------- Better Auth adapter tables ----------
// Required as-is by better-auth's Prisma adapter — field names and shape
// are fixed. Password (for email/password accounts) lives on Account.password,
// not on User — there's one Account row per sign-in method per user.

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  // synthetic issuer better-auth derives per provider (e.g. "local:credential"
  // for email/password, an OAuth-namespaced value for social providers) —
  // this, not providerId, is what it treats as the account's natural key
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- Manga ----------

model Manga {
  id                String   @id @default(cuid())
  author_id         String
  manga_title       String
  manga_synopsis    String
  cover_image_url   String?  // poster-style cover, used in browse grids / cards
  banner_image_url  String?  // wide hero image, used on the detail page
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  author     User       @relation("AuthoredManga", fields: [author_id], references: [id])
  arcs       Arc[]
  chapters   Chapter[]
  bookmarks  Bookmark[]

  @@index([author_id])
}

// ---------- Arc ----------

model Arc {
  id             String    @id @default(cuid())
  manga_id       String
  arc_name       String
  arc_order      Int
  // Any number of arcs on a manga can be flagged as special "ex"
  // (bonus/omake) entries — independent of arc_order, so each can be
  // dragged to sit anywhere in the list while always displaying "ex"
  // instead of a position number.
  arc_is_ex      Boolean   @default(false)
  arc_status     ArcStatus @default(ongoing)
  arc_image_url  String?   // cover image shown when browsing by arc
  created_at     DateTime  @default(now())

  manga    Manga     @relation(fields: [manga_id], references: [id], onDelete: Cascade)
  chapters Chapter[]

  // total_chapters and total_view are intentionally NOT stored here —
  // compute them at query time:
  //   total_chapters = chapters.length
  //   total_view     = sum(chapters[].view_count)

  @@index([manga_id])
  @@unique([manga_id, arc_order])
}

// ---------- Chapter ----------

model Chapter {
  id              String   @id @default(cuid())
  manga_id        String
  arc_id          String?
  chapter_number  Int
  // Any number of chapters on a manga can be flagged as special "ex"
  // (bonus/omake) entries — independent of chapter_number, so each can be
  // dragged to sit anywhere in the list while always displaying "ex"
  // instead of a position number. Mirrors Arc.arc_is_ex.
  chapter_is_ex   Boolean  @default(false)
  chapter_name    String
  cover_image_url String?  // thumbnail shown in the chapter list
  published_date  DateTime
  view_count      Int      @default(0)
  comment_count   Int      @default(0)
  created_at      DateTime @default(now())

  manga    Manga            @relation(fields: [manga_id], references: [id], onDelete: Cascade)
  arc      Arc?             @relation(fields: [arc_id], references: [id], onDelete: SetNull)
  translations      Translation[]
  comments          Comment[]
  reading_progress  ReadingProgress[]
  chapter_bookmarks ChapterBookmark[]

  @@index([manga_id])
  @@index([arc_id])
  @@unique([manga_id, chapter_number])
}

// ---------- Translation ----------

model Translation {
  id             String   @id @default(cuid())
  chapter_id     String
  language       Language
  file_url       String
  // Original filename as uploaded (e.g. "chapter-12-final.pdf") — the R2
  // object key itself is a random UUID, so this is purely for display in
  // the admin panel. Nullable since translations created before this field
  // existed have none.
  file_name      String?
  translator_id  String?
  created_at     DateTime @default(now())

  chapter    Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  translator User?   @relation("TranslatedBy", fields: [translator_id], references: [id])

  @@unique([chapter_id, language])
  @@index([chapter_id])
}

// ---------- Comment ----------

model Comment {
  id         String    @id @default(cuid())
  user_id    String
  chapter_id String
  body       String
  hidden_at  DateTime?
  created_at DateTime  @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@index([chapter_id])
  @@index([user_id])
}

// ---------- Bookmark ----------

model Bookmark {
  id         String   @id @default(cuid())
  user_id    String
  manga_id   String
  created_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  manga Manga @relation(fields: [manga_id], references: [id], onDelete: Cascade)

  @@unique([user_id, manga_id])
  @@index([manga_id])
}

// ---------- Chapter Bookmark ----------
// Separate from Bookmark (which is manga-level) — this is "favorite this
// specific chapter", a different relationship with its own unique pair.

model ChapterBookmark {
  id         String   @id @default(cuid())
  user_id    String
  chapter_id String
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@unique([user_id, chapter_id])
  @@index([chapter_id])
}

model ReadingProgress {
  id             String   @id @default(cuid())
  user_id        String
  chapter_id     String
  last_page_read Int      @default(0)
  completed      Boolean  @default(false)
  updated_at     DateTime @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@unique([user_id, chapter_id])
  @@index([chapter_id])
}
